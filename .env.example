# Frontend Environment Variables
# Copy this file to .env.local and fill with YOUR values

# Convex Backend URL
VITE_CONVEX_URL=http://127.0.0.1:3210
CONVEX_DEPLOYMENT=anonymous:anonymous-frontend
CONVEX_SITE_URL=http://localhost:3000

# Google OAuth (get from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Replicate API (get from replicate.com/account/api-tokens)
REPLICATE_API_TOKEN=your_replicate_token_here
SEADREAM_VERSION_ID=bytedance/seedream-4.5

# Database (if using local)
DATABASE_URL="file:./dev.db"
